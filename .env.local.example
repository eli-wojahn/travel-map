# Supabase Configuration
# Copie este arquivo para .env.local e preencha com suas credenciais

# Project URL (encontrado em Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Anon/Public Key (encontrado em Project Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-aqui

# Service Role Key (encontrado em Project Settings > API > service_role)
# ⚠️ NUNCA COMMITAR ESTA CHAVE - USE APENAS NO SERVIDOR
SUPABASE_SERVICE_ROLE_KEY=sua-chave-privada-aqui

# Keep-alive secret usado pela rota /api/keep-alive e pelo cron externo
# Gere um valor forte com: openssl rand -hex 32
KEEP_ALIVE_SECRET=850a19c669249ac6cfa40fe15d537d3cdcb5c2447cd3990180b43b4fb7c2920d
